{
  "compilerOptions": {
    "target": "ESNext", "module": "Preserve", "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"], "types": ["bun"],
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "noEmit": true, "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
